# Anthropic API key — get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# CryptoPanic API key (free tier) — get one at https://cryptopanic.com/developers/api/
# Powers crypto-specific news. Bot still works without it (uses general crypto RSS instead).
CRYPTOPANIC_API_KEY=

# OANDA practice (demo) account — powers gold/silver/oil/forex prices.
# Free signup: https://www.oanda.com/demo-account/tpa/personal_finance
# After signing up: Account API key is under "Manage API Access" in your account settings.
# Account ID looks like 101-001-12345678-001 and is shown on your account dashboard.
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice

# Crypto exchange credentials — only needed once you switch TRADING_MODE to "live"
# Leave blank while paper trading.
EXCHANGE_NAME=okx
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# "paper" or "live" — always start with paper
TRADING_MODE=paper
